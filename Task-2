USE Playstore_DB;

SELECT UPPER(DeveloperName) AS DeveloperName
FROM Developers;

SELECT LOWER(DeveloperName) AS DeveloperName
FROM Developers;

SELECT AppName, LENGTH(AppName) AS NameLength
FROM Apps;

SELECT CategoryName,
LENGTH(CategoryName) AS CategoryLength
FROM Categories;

SELECT CURRENT_DATE AS CurrentDate,
CURRENT_TIME AS CurrentTime;

SELECT AppName, Rating,
ROUND(Rating,0) AS RoundedRating
FROM Apps;

SELECT AppName,
LEFT(AppName,5) AS First5Characters
FROM Apps;

SELECT CONCAT(DeveloperName,'-',Country) AS DeveloperandCountry
FROM Developers;

SELECT AppName, Rating,
ROUND(Rating,0) AS RoundedRating
FROM Apps;

SELECT AppName, Price, CEIL(Price) AS CeilingPrice
FROM Apps;

SELECT DeveloperName, FoundedYear
FROM Developers;

SELECT AppName, Downloads,
CONVERT(Downloads, CHAR) AS Downloads_Character
FROM Apps;

SELECT UPPER(AppName) AS ApplicationName,
Rating
FROM Apps;

SELECT CategoryName,
LEFT(CategoryName, 3) AS First3Characters
FROM Categories;

SELECT AppName, Price,
ABS(Price - 200) AS AbsoluteDifference
FROM Apps;

SELECT DeveloperName,
LENGTH(DeveloperName) AS DeveloperNameLendth
FROM Developers;

SELECT CURRENT_DATE AS CurrentDate,
current_timestamp() AS CurrentTimeStamp;

SELECT AppName, Price,
CONVERT(Price, CHAR) PriceAsCharacter
FROM Apps;
